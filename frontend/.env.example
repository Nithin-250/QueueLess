# --------------------------------------------------------------------------
# QueueLess Frontend Environment
# Copy to `.env.local`. Variables prefixed with VITE_ are exposed to the
# browser - only put PUBLIC values here.
# --------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:4000/api/v1

# Note: Firebase configuration is no longer needed with DynamoDB backend.
# Real-time updates will be implemented via polling or AWS AppSync in the future.
# The frontend will use the backend API for all data operations.
